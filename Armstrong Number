
#include<iostream>
using namespace std;
int main(){
    int n;
    cin>>n;
     int sum=0;
    int dup =n;
    while (n>0)
    {
       int id=n%10;

       sum=sum+(id*id*id);
       n=n/10;

    }
    if (dup==sum){
        cout<<"armstrong";
        
    }
    else{
        cout<<"false";
    }
    

    return 0;

}
